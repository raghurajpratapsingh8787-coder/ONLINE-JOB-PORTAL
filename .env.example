# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# MongoDB Atlas Connection (optional in local preview; falls back to persistent local document store when unset)
MONGODB_URI=

# JWT Authentication Secrets (set strong random 64-char hex strings in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional Initial Super Admin Password Override
ADMIN_INITIAL_PASSWORD=

# Optional Redis Server-Side Caching
REDIS_URL=

# Optional Nodemailer SMTP Configuration for Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VanguardHire <notifications@vanguardhire.io>"

# Optional Cloudinary / Object Storage Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
